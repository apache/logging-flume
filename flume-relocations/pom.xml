<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.apache.flume</groupId>
    <artifactId>flume-project</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>flume-relocations</artifactId>
  <packaging>pom</packaging>
  <name>Flume Relocations</name>
  <description>Relocation POMs that redirect the Flume 1.x coordinates to their Flume 2.x replacements.</description>

  <modules>
    <module>flume-ng-sdk</module>
    <module>flume-ng-configuration</module>
    <module>flume-ng-core</module>
    <module>flume-ng-node</module>
    <module>flume-ng-auth</module>
    <module>flume-ng-config-filter-api</module>
    <module>flume-ng-environment-variable-config-filter</module>
    <module>flume-ng-external-process-config-filter</module>
    <module>flume-ng-hadoop-credential-store-config-filter</module>
    <module>flume-ng-embedded-agent</module>
    <module>flume-file-channel</module>
    <module>flume-spillable-memory-channel</module>
    <module>flume-jdbc-channel</module>
    <module>flume-kafka-channel</module>
    <module>flume-taildir-source</module>
    <module>flume-jms-source</module>
    <module>flume-kafka-source</module>
    <module>flume-scribe-source</module>
    <module>flume-twitter-source</module>
    <module>flume-hdfs-sink</module>
    <module>flume-hive-sink</module>
    <module>flume-ng-hbase2-sink</module>
    <module>flume-http-sink</module>
    <module>flume-irc-sink</module>
    <module>flume-ng-kafka-sink</module>
    <module>flume-ng-morphline-solr-sink</module>
    <module>flume-ng-elasticsearch-sink</module>
    <module>flume-shared-kafka</module>
    <module>flume-shared-kafka-test</module>
  </modules>

  <profiles>

    <!-- Activated by the `.flume-relocation-flatten-activator` file of each relocation module.
         Unlike this aggregator, the relocation POMs are installed and deployed.
         They are flattened like BOMs, so the published POMs do not refer to this aggregator,
         but keep `distributionManagement`, which holds the relocation. -->
    <profile>
      <id>relocation</id>
      <activation>
        <file>
          <exists>.flume-relocation-flatten-activator</exists>
        </file>
      </activation>
      <properties>
        <maven.install.skip>false</maven.install.skip>
        <maven.deploy.skip>false</maven.deploy.skip>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <executions>
              <!-- Declared first, so that `flatten-relocation` runs after it and its output wins. -->
              <execution>
                <id>flatten-revision</id>
              </execution>
              <execution>
                <id>flatten-relocation</id>
                <goals>
                  <goal>flatten</goal>
                </goals>
                <phase>process-resources</phase>
                <configuration>
                  <flattenMode>bom</flattenMode>
                  <pomElements>
                    <build>remove</build>
                    <dependencyManagement>remove</dependencyManagement>
                    <distributionManagement>keep</distributionManagement>
                    <profiles>remove</profiles>
                    <properties>remove</properties>
                    <repositories>remove</repositories>
                  </pomElements>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

  </profiles>

</project>
